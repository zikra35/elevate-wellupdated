# Backend (Railway) - set these in Railway > service > Variables. Never commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=<long random string>
# Optional
JWT_EXPIRY=7d
# Extra allowed frontend origins, comma-separated (*.vercel.app is always allowed)
CORS_ORIGINS=
# Sage uses OpenAI only when this is set; otherwise it uses built-in replies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional Python ML service for recommendations
ML_SERVICE_URL=
